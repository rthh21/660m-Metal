--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1
compatibility-version: 1
exports:
  - targets:         [ x86_64-macos ]
    symbols:         [ _printf, _fflush, _usleep, _memset, _memcpy, _bzero, _exit, dyld_stub_binder ]
...
